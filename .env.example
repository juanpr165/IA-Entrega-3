# Groq API key (obtain it from https://console.groq.com/keys)
GROQ_API_KEY=

# Groq chat model. This model name may be changed to one enabled in your account.
GROQ_MODEL=penai/gpt-oss-120b

# Local, free embedding model used BOTH at ingestion and query time.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional paths (relative to the project root)
DATA_DIR=data
CHROMA_DIR=vectorstore
